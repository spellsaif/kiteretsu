      "import": "./dist/watcher.js",
      "types": "./dist/watcher.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run --testTimeout=15000"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "crypto-js": "^4.2.0",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.0",
    "knex": "^3.1.0",
    "p-limit": "^7.3.0",
    "sharp": "^0.34.5",
    "sqlite-vec": "^0.1.9",
    "tree-sitter-wasms": "^0.1.13",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.25.3",
    "xxhash-wasm": "^1.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.0.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}