{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@kiteretsu/core": ["packages/core/src"],
      "@kiteretsu/core/*": ["packages/core/src/*"],
      "@kiteretsu/agent-bridge": ["packages/agent-bridge/src"],
      "@kiteretsu/agent-bridge/*": ["packages/agent-bridge/src/*"],
      "@kiteretsu/mcp-server": ["packages/mcp-server/src"],
      "@kiteretsu/mcp-server/*": ["packages/mcp-server/src/*"],
      "kiteretsu": ["packages/cli/src"],
      "kiteretsu/*": ["packages/cli/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
